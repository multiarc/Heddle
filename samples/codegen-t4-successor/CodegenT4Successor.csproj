<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Heddle.Samples.Codegen</RootNamespace>
    <EnableDefaultHeddleTemplates>false</EnableDefaultHeddleTemplates>
    <!-- Take full control of the compile set: only our own sources. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- A code generator emits raw source, not HTML: pin the Text profile and keep directive lines. The 2.0
         engine defaults are Html + directive-line trimming, which would encode the generated code
         and drop whitespace-only lines — wrong for code generation. -->
    <HeddleOutputProfile>Text</HeddleOutputProfile>
    <HeddleTrimDirectiveLines>false</HeddleTrimDirectiveLines>
  </PropertyGroup>

  <!-- Build-time precompilation through Heddle.Build: the templates compile out of process and the
       assembly embeds the artifact plus the generated entry points (Heddle.Generated.*). -->
  <Import Project="..\..\src\Heddle.Build\build\Heddle.Build.props" />
  <Import Project="..\..\src\Heddle.Build\build\Heddle.Build.targets" />

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\tools\SampleCapture.cs" Link="SampleCapture.cs" />
    <ProjectReference Include="..\..\src\Heddle\Heddle.csproj" />
    <ProjectReference Include="..\..\src\Heddle.Build\Heddle.Build.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Heddle.Tool\Heddle.Tool.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Rooted: a relative path here would resolve against the imported targets file. -->
  <PropertyGroup>
    <HeddleBuildTasksPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/Heddle.Build/bin/$(Configuration)/netstandard2.0/Heddle.Build.Tasks.dll'))</HeddleBuildTasksPath>
    <HeddleToolPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/Heddle.Tool/bin/$(Configuration)/net10.0/Heddle.Tool.dll'))</HeddleToolPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ModelType item metadatum types the template from the project file: report.heddle carries no @model
         directive, yet the generated entry point is typed BuildInfo. If the metadatum stops flowing from a real
         csproj, the entry point degrades to `object model` and the generated-source golden catches the change. -->
    <HeddleTemplate Include="templates\report.heddle" ModelType="Heddle.Samples.Codegen.BuildInfo" />
    <!-- The Name item metadatum is an ADDITIONAL import name, not a rename. This partial keeps its
         path-derived key `templates/_banner.heddle` AND answers to `Banner`, which is the spelling report.heddle
         imports. Precompile="false" makes it import-only: no entry point, no manifest row. This is also the
         behavioural gate for finding 10 — if the per-item metadata stops flowing from a real csproj again, the
         import stops resolving and the build fails with HED7011 instead of degrading quietly. -->
    <HeddleTemplate Include="templates\_banner.heddle" Name="Banner" Precompile="false" />
  </ItemGroup>

</Project>
