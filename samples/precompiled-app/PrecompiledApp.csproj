<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\heddle.snk</AssemblyOriginatorKeyFile>
    <EnableDefaultHeddleTemplates>false</EnableDefaultHeddleTemplates>
  </PropertyGroup>

  <!-- Build-time precompilation through Heddle.Build: the templates compile out of process and the
       assembly embeds the artifact plus the generated entry points (Heddle.Generated.*). -->
  <Import Project="..\..\src\Heddle.Build\build\Heddle.Build.props" />
  <Import Project="..\..\src\Heddle.Build\build\Heddle.Build.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\Heddle\Heddle.csproj" />
    <ProjectReference Include="..\..\src\Heddle.Build\Heddle.Build.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Heddle.Tool\Heddle.Tool.csproj" ReferenceOutputAssembly="false" />
    <!-- Acme.Models is built before this project so its assembly feeds the implementation set. -->
    <ProjectReference Include="external-models\ExternalModels.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Rooted: a relative path here would resolve against the imported targets file. -->
  <PropertyGroup>
    <HeddleBuildTasksPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/Heddle.Build/bin/$(Configuration)/netstandard2.0/Heddle.Build.Tasks.dll'))</HeddleBuildTasksPath>
    <HeddleToolPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/Heddle.Tool/bin/$(Configuration)/net10.0/Heddle.Tool.dll'))</HeddleToolPath>
  </PropertyGroup>

  <PropertyGroup>
    <AcmeModelsAssembly>$(MSBuildProjectDirectory)\external-models\bin\$(Configuration)\netstandard2.0\Acme.Models.dll</AcmeModelsAssembly>
  </PropertyGroup>

  <ItemGroup>
    <HeddleTemplate Include="templates\invoice.heddle" />
    <HeddleTemplate Include="templates\receipt.heddle" />
    <HeddleTemplate Include="templates\ticket.heddle" />

    <!-- The external-models assembly feeds both the compiler (model types) and the runtime
         (ModuleInitializer loads the copy). -->
    <None Include="$(AcmeModelsAssembly)" CopyToOutputDirectory="PreserveNewest" Visible="false">
      <Link>Acme.Models.dll</Link>
    </None>
    <HeddleModelAssembly Include="$(AcmeModelsAssembly)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- external-models is its own project, reached through @(HeddleModelAssembly) and the in-source
         assembly attribute; compiling its sources here too would put Acme.Models.Ticket in the app
         AND in the reference (CS0436, and HED7023 by construction). -->
    <Compile Remove="external-models\**\*.cs" />
    <Compile Include="..\tools\SampleCapture.cs" Link="SampleCapture.cs" />
    <ProjectCapability Include="SupportsSystemTextJson" />
  </ItemGroup>

</Project>
