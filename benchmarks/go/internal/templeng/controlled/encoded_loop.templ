// Workload 8 — encoded-loop, templ controlled port: byte-parity with the shared golden
// after normalization. data-tag={ r.Tag } is templ's attribute expression (auto-quoted and
// attribute-encoded); the other two substitutions are text-context. All emitted spellings
// sit inside the N5 table (the feasibility spike's P2 probe pinned the exact bytes).
package controlled

import "heddle.dev/benchmarks/go/internal/model"

templ encodedLoop(m model.EncodedLoopModel) {
	<table>
		for _, r := range m.Items {
			<tr><td data-tag={ r.Tag }>{ r.Name }</td><td>{ r.Comment }</td></tr>
		}
	</table>
}
