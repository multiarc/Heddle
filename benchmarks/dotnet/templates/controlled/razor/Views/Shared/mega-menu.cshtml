@*
    Razor parity twin -- composed-page mega-menu partial (ledger E20/E22).

    One mega menu: the tab loop with the per-tab dropdown, each dropdown column rendered
    through the nested nav-column partial (menu -> column -> section -> link), mirroring
    Heddle's mega_menu definition. Html.Raw: raw-suite non-encoding path.
*@
@using Heddle.Benchmarks.Dotnet.Models
@model MegaMenu
<div class="top-menu-wrapper"><ul class="top-menu">@foreach (var tab in Model.Tabs)
{<li class="@Html.Raw(tab.Css)"><a href="@Html.Raw(tab.Href)" class="drop">@Html.Raw(tab.Label)</a>@if (tab.HasDropdown)
    {<div class="@Html.Raw(tab.DropdownCss)">@foreach (var column in tab.Columns)
        {@await Html.PartialAsync("/Views/Shared/nav-column.cshtml", column)}</div>}</li>}</ul></div>
