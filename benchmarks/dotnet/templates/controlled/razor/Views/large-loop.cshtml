@*
    Razor parity twin -- large-loop.

    The display name is composed by the TEMPLATE as literal-plus-substitution
    (`row-@(item.Value)`): the model carries the int only.
*@
@using Heddle.Benchmarks.Dotnet.Models
@model LoopContent.LoopModel
@{ Layout = null; }
@foreach (var item in Model.Items)
{<tr><td>row-@item.Value</td><td>@item.Value</td></tr>}
