<div class="top-menu-wrapper"><ul class="top-menu">{{ for tab in menu.tabs }}<li class="{{ tab.css }}"><a href="{{ tab.href }}" class="drop">{{ tab.label }}</a>{{ if tab.has_dropdown }}<div class="{{ tab.dropdown_css }}">{{ for column in tab.columns }}{{ include 'nav-column' }}{{ end }}</div>{{ end }}</li>{{ end }}</ul></div>
