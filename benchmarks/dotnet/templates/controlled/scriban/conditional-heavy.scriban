<ul class="matrix">{{ for r in rows }}<li>{{ if r.is_bronze }}<span class="t0">bronze</span>{{ else if r.is_silver }}<span class="t1">silver</span>{{ else if r.is_gold }}<span class="t2">gold</span>{{ else }}<span class="t3">platinum</span>{{ end }}<em>{{ r.name }}</em>{{ if r.has_note }}<small>{{ r.note }}</small>{{ end }}{{ if r.is_active }}<b>active</b>{{ end }}</li>{{ end }}</ul>