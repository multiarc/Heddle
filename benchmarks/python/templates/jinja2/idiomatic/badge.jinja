{# Idiomatic Jinja2 badge sub-fragment: nested inside the card fragment,
   called against the row's promo member (Phase 5 D5, ledger E20).
   Doc: https://jinja.palletsprojects.com/en/stable/templates/#macros #}
{% macro badge(promo) %}
<span class="promo-badge">{{ promo.label }}</span>
{% endmacro %}
