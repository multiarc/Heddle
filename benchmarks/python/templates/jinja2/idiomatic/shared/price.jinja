{# Idiomatic Jinja2 price sub-fragment: nested inside the card fragment; the
   display price is template-composed as the promo price int plus the literal
   `.99`.
   Doc: https://jinja.palletsprojects.com/en/stable/templates/#macros #}
{% macro price(promo) %}
<p class="price">{{ promo.price }}.99</p>
{% endmacro %}
