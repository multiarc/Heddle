{# Idiomatic Jinja2 media-row fragment: the media caption (`Caption for ` +
   name) and image src (`/img/` + name + `.jpg`) are template-composed as
   literal-plus-substitution (Phase 5 D5, ledger E20/E21).
   Doc: https://jinja.palletsprojects.com/en/stable/templates/#macros #}
{% macro media_row(item) %}
<div class="media-row">
  <img src="/img/{{ item.name }}.jpg" alt="{{ item.name }}" />
  <div class="media-body">
    <h4>{{ item.name }}</h4>
    <p>Caption for {{ item.name }}</p>
  </div>
</div>
{% endmacro %}
