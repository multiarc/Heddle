{# Idiomatic Jinja2 stat fragment: one of the four dispatched fragment kinds,
   as a macro imported by fragment-heavy.jinja (Phase 5 D5, ledger E20).
   Doc: https://jinja.palletsprojects.com/en/stable/templates/#macros #}
{% macro stat(item) %}
<div class="stat">
  <span class="stat-name">{{ item.name }}</span>
  <span class="stat-value">{{ item.value }}</span>
  <span class="stat-delta">{{ item.delta }}</span>
</div>
{% endmacro %}
