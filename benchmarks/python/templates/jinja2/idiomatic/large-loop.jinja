{# Idiomatic Jinja2 large-loop: a {% for %} loop over items, one row per source
   line; the display name is template-composed as the literal `row-` plus the
   value substitution.
   Doc: https://jinja.palletsprojects.com/en/stable/templates/#for #}
{% for item in items %}
<tr><td>row-{{ item.value }}</td><td>{{ item.value }}</td></tr>
{% endfor %}
