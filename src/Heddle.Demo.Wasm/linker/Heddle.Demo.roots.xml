<?xml version="1.0" encoding="utf-8"?>
<!--
  The engine reflection roots for the trimmed WASM publish. These members are reached only by
  reflection (Activator-created extensions via TemplateFactory; registry MethodInfos), so the trimmer cannot see
  the reference and would strip them without these roots. Deliberately roots NOTHING in ContextCompilation — the
  feature-switch substitution (ILLink.Substitutions.xml) must be free to eliminate the guarded Roslyn branch, and the purity gate asserts the result.
  The boot smoke test is the completeness check: an over-trimmed member fails completion/render visibly there.
-->
<linker>
  <assembly fullname="Heddle">
    <type fullname="Heddle.Extensions.*" />                          <!-- Activator-created extensions -->
    <type fullname="Heddle.Runtime.Expressions.BuiltInFunctions" />  <!-- registry MethodInfos (the default function set) -->
  </assembly>
</linker>
