<Project>

  <!-- The extension below is the XML twin of TemplateKey.TemplateExtension, which is normative; MSBuild cannot
       reference the const, so the two are kept in step by review. -->
  <ItemGroup Condition="'$(EnableDefaultHeddleTemplates)' != 'false'">
    <HeddleTemplate Include="**\*.heddle" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);bin\**;obj\**" />
  </ItemGroup>

  <!-- `Include="@(HeddleTemplate)"` is an item transform, so Key, Name and Precompile are already copied.
       Do NOT restate them as `<Key>%(HeddleTemplate.Key)</Key>`: outside a target a cross-item `%(Other.Metadata)`
       reference evaluates to the empty string, so each such element overwrites the metadatum the transform just
       copied. That made every per-item metadatum inert from a real csproj — mapping it explicitly is what unmapped
       it. Guarded structurally by
       `PipelineContractTests.EveryDeclaredItemMetadataIsReadByTheGeneratorAndNotNulledByTheTargets`, and
       behaviourally by `samples/codegen-t4-successor`, whose import-only partial is imported by its `Name` and so
       fails the build with HED7011 in CI if the metadatum stops flowing. -->
  <ItemGroup>
    <AdditionalFiles Include="@(HeddleTemplate)">
      <HeddleTemplate>true</HeddleTemplate>
    </AdditionalFiles>
  </ItemGroup>

</Project>
