<Project>

  <!-- Phase 7 D12/D14: compilation-wide options surfaced to the generator as build_property.* -->
  <ItemGroup>
    <CompilerVisibleProperty Include="HeddleOutputProfile" />
    <CompilerVisibleProperty Include="HeddleExpressionMode" />
    <CompilerVisibleProperty Include="HeddleTrimDirectiveLines" />
    <CompilerVisibleProperty Include="HeddleMaxRecursionCount" />
    <CompilerVisibleProperty Include="HeddleTemplateRoot" />
    <CompilerVisibleProperty Include="HeddleGeneratedNamespace" />
    <CompilerVisibleProperty Include="HeddleEmitUtf8Pieces" />
  </ItemGroup>

  <!-- Per-item metadata surfaced as build_metadata.AdditionalFiles.*.
       `Precompile` is the per-item opt-out (phase 5, Q5.1): the file stays in the @<< import map, but emits no entry
       point and no manifest entry.
       `Key` and `Name` are two spellings of ONE setting — the item's explicit registration key, overriding the
       path-derived one (Q8.12; phase 5 deleted `Name` on an overreaching record and it is restored here as the real
       feature it was always meant to be). Both go through TemplateKey normalisation and both participate in HED7002 /
       HED7003 / HED7004; either one suppresses HED7018, because an explicit key makes the flattened out-of-root key
       intentional. Every name declared here is mapped onto AdditionalFiles by Heddle.Generator.targets and read by
       the generator; the props↔targets↔code set-equality gate in PipelineContractTests is what makes a
       declared-but-never-wired metadata name — exactly what `Name` was — a red test instead of dead XML. -->
  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Key" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Name" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Precompile" />
  </ItemGroup>

  <!-- Defaults (stated explicitly; flipped together with the engine defaults in the 2.0 window). The normative
       table is Heddle.Precompiled.HeddleBuildOptions (phase 5 D8) — HeddleTemplateRoot's default is expressible
       only here, so this XML stays a second physical statement and the props↔code↔runtime lockstep test proves the
       two never diverge. -->
  <PropertyGroup>
    <HeddleOutputProfile Condition="'$(HeddleOutputProfile)' == ''">Html</HeddleOutputProfile>
    <HeddleExpressionMode Condition="'$(HeddleExpressionMode)' == ''">Native</HeddleExpressionMode>
    <HeddleTrimDirectiveLines Condition="'$(HeddleTrimDirectiveLines)' == ''">true</HeddleTrimDirectiveLines>
    <HeddleMaxRecursionCount Condition="'$(HeddleMaxRecursionCount)' == ''">100</HeddleMaxRecursionCount>
    <HeddleTemplateRoot Condition="'$(HeddleTemplateRoot)' == ''">$(MSBuildProjectDirectory)</HeddleTemplateRoot>
    <HeddleEmitUtf8Pieces Condition="'$(HeddleEmitUtf8Pieces)' == ''">false</HeddleEmitUtf8Pieces>
  </PropertyGroup>

</Project>
