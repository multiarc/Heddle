<Project Sdk="Microsoft.NET.Sdk">

  <!-- The packable project, and the 4.1.0 (floor) variant. 4.1.0 is what src/Heddle/Heddle.csproj pins for its
       netstandard2.0 leg, and it is the variant every net48 compiler host (VS 2022, msbuild.exe) and every
       pre-versioning SDK loads. Source must therefore compile against the 4.1.0 API surface; anything newer is
       #if-guarded (see Heddle.Generator.Common.props). -->
  <PropertyGroup>
    <HeddleRoslynApiVersion>4.1.0</HeddleRoslynApiVersion>
  </PropertyGroup>

  <Import Project="Heddle.Generator.Common.props" />

  <PropertyGroup>
    <PackageId>Heddle.Generator</PackageId>
    <Description>Build-time template pre-compilation for Heddle (incremental source generator).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-order edges only: the pack target below reaches into the variants' output paths, and without
         these references nothing orders a `dotnet pack` of this project after their builds. -->
    <ProjectReference Include="Heddle.Generator.Roslyn411.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Heddle.Generator.Roslyn530.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Pack layout: one analyzer folder per Roslyn API version — analyzers/dotnet/roslyn{4.1,4.11,5.3}/cs — from
       which a versioning-aware host picks the highest folder its compiler supports; hosts without
       SupportsRoslynComponentVersioning would load ALL of them, which buildTransitive\Heddle.Generator.targets
       trims back to the 4.1 floor. MSBuild props/targets under buildTransitive. Microsoft.CodeAnalysis* is never
       shipped. Each folder carries its own Heddle.Language + ANTLR copies because the compiler resolves an
       analyzer's dependencies from the analyzer's own directory. -->
  <ItemGroup>
    <None Include="build\Heddle.Generator.props" Pack="true" PackagePath="buildTransitive\Heddle.Generator.props" />
    <None Include="build\Heddle.Generator.targets" Pack="true" PackagePath="buildTransitive\Heddle.Generator.targets" />
    <!-- Directory.Build.props sets PackageReadmeFile=README.md for every project, so the file must be
         packed (else NU5039). Matches the other packable projects. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="_HeddlePackAnalyzers" DependsOnTargets="ResolveReferences" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <!-- The variants' obj/bin are isolated per project name by this directory's Directory.Build.props;
           these paths are that convention, restated for the pack. -->
      <_HeddleRoslyn411Out>bin\Heddle.Generator.Roslyn411\$(Configuration)\netstandard2.0\</_HeddleRoslyn411Out>
      <_HeddleRoslyn530Out>bin\Heddle.Generator.Roslyn530\$(Configuration)\netstandard2.0\</_HeddleRoslyn530Out>
    </PropertyGroup>
    <ItemGroup>
      <None Include="$(OutputPath)Heddle.Generator.dll" Pack="true" PackagePath="analyzers\dotnet\roslyn4.1\cs" Visible="false" />
      <None Include="$(OutputPath)Heddle.Language.dll" Pack="true" PackagePath="analyzers\dotnet\roslyn4.1\cs" Visible="false" />
      <None Include="$(PkgAntlr4_Runtime_Standard)\lib\netstandard2.0\Antlr4.Runtime.Standard.dll"
            Pack="true" PackagePath="analyzers\dotnet\roslyn4.1\cs" Visible="false" />

      <None Include="$(_HeddleRoslyn411Out)Heddle.Generator.dll" Pack="true" PackagePath="analyzers\dotnet\roslyn4.11\cs" Visible="false" />
      <None Include="$(OutputPath)Heddle.Language.dll" Pack="true" PackagePath="analyzers\dotnet\roslyn4.11\cs" Visible="false" />
      <None Include="$(PkgAntlr4_Runtime_Standard)\lib\netstandard2.0\Antlr4.Runtime.Standard.dll"
            Pack="true" PackagePath="analyzers\dotnet\roslyn4.11\cs" Visible="false" />

      <None Include="$(_HeddleRoslyn530Out)Heddle.Generator.dll" Pack="true" PackagePath="analyzers\dotnet\roslyn5.3\cs" Visible="false" />
      <None Include="$(OutputPath)Heddle.Language.dll" Pack="true" PackagePath="analyzers\dotnet\roslyn5.3\cs" Visible="false" />
      <None Include="$(PkgAntlr4_Runtime_Standard)\lib\netstandard2.0\Antlr4.Runtime.Standard.dll"
            Pack="true" PackagePath="analyzers\dotnet\roslyn5.3\cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
