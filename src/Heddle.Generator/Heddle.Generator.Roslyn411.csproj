<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Roslyn 4.11 variant: same sources, same netstandard2.0 assembly identity, compiled against the
       Microsoft.CodeAnalysis version src/Heddle/Heddle.csproj pins for net8.0. Packed by Heddle.Generator.csproj
       into analyzers/dotnet/roslyn4.11/cs; consumed directly by the test projects' net8.0 legs so the variant a
       .NET 8 SDK host would select is the one that leg exercises. -->
  <PropertyGroup>
    <HeddleRoslynApiVersion>4.11.0</HeddleRoslynApiVersion>
  </PropertyGroup>

  <Import Project="Heddle.Generator.Common.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);ROSLYN_4_11_OR_GREATER</DefineConstants>
  </PropertyGroup>

</Project>
