@using(){{Heddle.Runtime}}@\
@model(){{ExpressionOptions}}@\
@list(CSharpNamespaces) {{
	using @();
}}

namespace Heddle.Runtime {
	public static class CSharpExpression {
		private static void Main (string[] args) {}

		public static object PreProcessData(@(ModelCSharpType) model, @(ChainedCSharpType) chained, @(RootModelCSharpType) root)
		{
			return unchecked(@(Expression));
		}
	}
}