<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Strong-named like every other first-party assembly: unsigned, it draws CS8002 in the signed
         Heddle.LanguageServices.Tests that references it. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\heddle.snk</AssemblyOriginatorKeyFile>
    <!-- The demo picker reflects over these models, so the WASM host trim-roots the whole assembly
         (TrimmerRootAssembly). Keep it POCO-only. -->
  </PropertyGroup>

</Project>
