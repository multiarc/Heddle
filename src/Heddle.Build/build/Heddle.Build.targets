<Project>

  <!-- The task assembly lives beside these files in the package (tasks/netstandard2.0/); in-repo
       consumers overriding HeddleBuildTasksPath point at the built Heddle.Build output instead. -->
  <PropertyGroup>
    <HeddleBuildTasksPath Condition="'$(HeddleBuildTasksPath)' == ''">$(MSBuildThisFileDirectory)../tasks/netstandard2.0/Heddle.Build.Tasks.dll</HeddleBuildTasksPath>
    <HeddleToolPath Condition="'$(HeddleToolPath)' == ''">$(MSBuildThisFileDirectory)../tools/net10.0/any/Heddle.Tool.dll</HeddleToolPath>
  </PropertyGroup>
  <UsingTask TaskName="HeddleCompile" AssemblyFile="$(HeddleBuildTasksPath)" />

  <!-- The extension below is the XML twin of TemplateKey.TemplateExtension, which is normative. -->
  <ItemGroup Condition="'$(EnableDefaultHeddleTemplates)' != 'false'">
    <HeddleTemplate Include="**\*.heddle" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);bin\**;obj\**" />
  </ItemGroup>

  <!-- Per-item metadata flows on the items themselves — Key, Name, ModelType, Precompile and the
       OutputProfile override — never restated here: outside a target a cross-item %(Other.Metadata)
       reference evaluates to the empty string and would delete what the declaration copied. -->

  <!-- Declared assemblies reach the compiler (the primary form stays the in-source attribute; these
       items exist for templates-only projects and unnameable model assemblies). Absent items add
       nothing, so an unset item set is byte-identical output. -->
  <Target Name="_HeddleAddDeclaredAssemblyReferences"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Include="@(HeddleModelAssembly)" />
      <ReferencePath Include="@(HeddleExtensionAssembly)" />
    </ItemGroup>
  </Target>

  <!-- Lazy: IntermediateOutputPath gains its configuration value after imports evaluate, so
       paths computed at import time freeze empty. Every heddle target depends on this first. -->
  <Target Name="_HeddlePaths">
    <PropertyGroup>
      <_HeddleDir>$(IntermediateOutputPath)heddle/</_HeddleDir>
      <_HeddleArtifactPath>$(_HeddleDir)Heddle.CompiledForm.bin</_HeddleArtifactPath>
      <_HeddleSourcePath>$(_HeddleDir)Heddle.CompiledForm.g.cs</_HeddleSourcePath>
      <_HeddleStampPath>$(_HeddleDir)stamp.txt</_HeddleStampPath>
      <_HeddleProbePath>$(_HeddleDir)probe.json</_HeddleProbePath>
      <_HeddleStubsPath>$(_HeddleDir)stubs/Heddle.Generated.Stubs.g.cs</_HeddleStubsPath>
      <_HeddleResponsePath>$(_HeddleDir)compile.rsp</_HeddleResponsePath>
    </PropertyGroup>
  </Target>

  <!-- The implementation set the host binds over: project references' real outputs (not the
       reference assemblies CoreCompile sees), packages' runtime images, declared assemblies, and
       the intermediate model assembly when the probe earned one. Independent of
       CopyLocalLockFileAssemblies. -->
  <!-- After ResolveAssemblyReferences only: ResolvePackageAssets completes before it, so both
       item sets are populated; hooking ResolvePackageAssets as well fires the target during restore
       and again before ResolveAssemblyReferences has produced ReferencePath. -->
  <Target Name="_HeddleCollectImages"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <_HeddleImplementationImage Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
      <_HeddleImplementationImage Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.Extension)' == '.dll'" />
      <_HeddleImplementationImage Include="@(HeddleModelAssembly)" />
      <_HeddleImplementationImage Include="@(HeddleExtensionAssembly)" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_HeddleImplementationImage)">
      <Output TaskParameter="Filtered" ItemName="_HeddleImplementationImageDeduped" />
    </RemoveDuplicates>
    <ItemGroup>
      <_HeddleImplementationImage Remove="@(_HeddleImplementationImage)" />
      <_HeddleImplementationImage Include="@(_HeddleImplementationImageDeduped)" />
    </ItemGroup>
  </Target>

  <!-- The resolved Heddle reference the host's version lock checks itself against. -->
  <Target Name="_HeddleEngineReference"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <_HeddleEngineReference Include="@(ReferencePath)" Condition="'%(Filename)' == 'Heddle'" />
    </ItemGroup>
  </Target>

  <!-- The probe runs first: a parse-only pass collecting model spellings. Its unresolved count
       decides the intermediate compile; the real compile never runs at design time. -->
  <Target Name="_HeddleProbe"
          AfterTargets="BeforeCompile"
          BeforeTargets="_HeddleIntermediateCompile;_HeddleCompile"
          DependsOnTargets="_HeddlePaths;_HeddleCollectImages;_HeddleEngineReference"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true' and '@(HeddleTemplate)' != ''">
    <HeddleCompile
        Templates="@(HeddleTemplate)"
        ProjectPath="$(MSBuildProjectFullPath)"
        TemplateRoot="$(HeddleTemplateRoot)"
        OutputProfile="$(HeddleOutputProfile)"
        ExpressionMode="$(HeddleExpressionMode)"
        TrimDirectiveLines="$(HeddleTrimDirectiveLines)"
        MaxRecursionCount="$(HeddleMaxRecursionCount)"
        GeneratedNamespace="$(HeddleGeneratedNamespace)"
        ImplementationImages="@(_HeddleImplementationImage)"
        EngineReference="@(_HeddleEngineReference->'%(FullPath)')"
        ToolPath="$(HeddleToolPath)"
        ResponseFilePath="$(_HeddleResponsePath)"
        ProbeJson="$(_HeddleProbePath)">
      <Output TaskParameter="UnresolvedCount" PropertyName="_HeddleUnresolvedCount" />
    </HeddleCompile>
    <ItemGroup>
      <FileWrites Include="$(_HeddleProbePath)" />
    </ItemGroup>
  </Target>

  <!-- Same-project models: the build cannot see a type the project it is building declares without
       compiling it once. The stubs declare every wrapper with throwing bodies; the Csc pass compiles
       the project's own sources plus the stubs into an assembly carrying the project's own name, so
       identities recorded from it equal the built assembly's. Content-addressed and reused. -->
  <Target Name="_HeddleIntermediateCompile"
          AfterTargets="BeforeCompile"
          BeforeTargets="_HeddleCompile"
          DependsOnTargets="_HeddlePaths;_HeddleProbe"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true' and '$(_HeddleUnresolvedCount)' != '' and '$(_HeddleUnresolvedCount)' != '0' and '@(Compile)' != ''">
    <HeddleCompile
        Templates="@(HeddleTemplate)"
        ProjectPath="$(MSBuildProjectFullPath)"
        TemplateRoot="$(HeddleTemplateRoot)"
        OutputProfile="$(HeddleOutputProfile)"
        ExpressionMode="$(HeddleExpressionMode)"
        TrimDirectiveLines="$(HeddleTrimDirectiveLines)"
        MaxRecursionCount="$(HeddleMaxRecursionCount)"
        GeneratedNamespace="$(HeddleGeneratedNamespace)"
        ToolPath="$(HeddleToolPath)"
        ResponseFilePath="$(_HeddleResponsePath)"
        StubsOnly="$(_HeddleStubsPath)"
        CompileSources="@(Compile)"
        DigestReferences="@(ReferencePathWithRefAssemblies)"
        Analyzers="@(Analyzer)">
      <Output TaskParameter="IntermediateDigest" PropertyName="_HeddleDigest" />
    </HeddleCompile>
    <ItemGroup>
      <_HeddleIntermediateModel Include="$(_HeddleDir)models/$(_HeddleDigest)/$(AssemblyName).dll" />
      <_HeddleModelSources Include="@(Compile->'%(FullPath)')" Exclude="$(_HeddleSourcePath);$(_HeddleStubsPath);$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)'))**;$([System.IO.Path]::GetFullPath('$(OutputPath)'))**" />
      <_HeddleModelSources Include="$(_HeddleStubsPath)" />
    </ItemGroup>
    <MakeDir Directories="$(_HeddleDir)models/$(_HeddleDigest)" />
    <Csc Sources="@(_HeddleModelSources)"
         References="@(ReferencePathWithRefAssemblies)"
         Analyzers="@(Analyzer)"
         DefineConstants="$(DefineConstants)"
         LangVersion="$(LangVersion)"
         Nullable="$(Nullable)"
         AllowUnsafeBlocks="$(AllowUnsafeBlocks)"
         CheckForOverflowUnderflow="$(CheckForOverflowUnderflow)"
         TreatWarningsAsErrors="false"
         WarningLevel="0"
         OutputAssembly="@(_HeddleIntermediateModel)" />
  </Target>

  <!-- Design-time builds get compiling stubs and nothing else: no engine compile, image load,
       artifact, source or stamp — so a following real build finds _HeddleCompile out of date. -->
  <Target Name="_HeddleDesignTimeStubs"
          DependsOnTargets="_HeddlePaths"
          BeforeTargets="CoreCompile"
          Condition="('$(DesignTimeBuild)' == 'true' or '$(BuildingProject)' != 'true') and '@(HeddleTemplate)' != ''">
    <HeddleCompile
        Templates="@(HeddleTemplate)"
        ProjectPath="$(MSBuildProjectFullPath)"
        TemplateRoot="$(HeddleTemplateRoot)"
        OutputProfile="$(HeddleOutputProfile)"
        ExpressionMode="$(HeddleExpressionMode)"
        TrimDirectiveLines="$(HeddleTrimDirectiveLines)"
        MaxRecursionCount="$(HeddleMaxRecursionCount)"
        GeneratedNamespace="$(HeddleGeneratedNamespace)"
        ToolPath="$(HeddleToolPath)"
        ResponseFilePath="$(_HeddleResponsePath)"
        StubsOnly="$(_HeddleStubsPath)" />
    <ItemGroup>
      <Compile Include="$(_HeddleStubsPath)" />
    </ItemGroup>
  </Target>

  <!-- The resource item must join before AssignTargetPaths (the first PrepareResourceNames step):
       BeforeTargets hooks run after the hooked target's own dependencies, so hooking PrepareResourceNames
       lands after SplitResourcesByCulture and the item misses its Type metadata. The file
       itself is written later by _HeddleCompile, before CoreCompile reads it; on skipped (up-to-date)
       builds the previous file is still there. Same guard as the compile, so design-time builds that
       only get stubs never reference the artifact. -->
  <Target Name="_HeddleResourceNames"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="_HeddlePaths"
          Condition="'$(DesignTimeBuild)' != 'true' and '@(HeddleTemplate)' != ''">
    <ItemGroup>
      <EmbeddedResource Include="$(_HeddleArtifactPath)">
        <LogicalName>Heddle.CompiledForm</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- The five retired 2.x properties warn (HED7037) rather than error: an old project file keeps
       building byte-identical output, and only the warning says the option no longer exists. The observe-path
       properties retire silently. Their own target, ahead of CoreCompile, so a stale option warns even on a
       project whose templates are all import-only (where the compile itself has nothing to do). -->
  <Target Name="_HeddleRetiredPropertyWarnings"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Warning Code="HED7037" Text="HeddleObserveEngine is retired and ignored."
             Condition="'$(HeddleObserveEngine)' != ''" />
    <Warning Code="HED7037" Text="HeddleNodeFallback is retired and ignored."
             Condition="'$(HeddleNodeFallback)' != ''" />
    <Warning Code="HED7037" Text="HeddleEmitUtf8Pieces is retired and ignored."
             Condition="'$(HeddleEmitUtf8Pieces)' != ''" />
    <Warning Code="HED7037" Text="HeddleObserveIntermediatePath is retired and ignored."
             Condition="'$(HeddleObserveIntermediatePath)' != ''" />
    <Warning Code="HED7037" Text="HeddleObserveImplementationPath is retired and ignored."
             Condition="'$(HeddleObserveImplementationPath)' != ''" />
  </Target>

  <!-- The compile: MSBuild-level incrementality on inputs, stamp-level inside the host. Outputs join
       FileWrites; the source joins Compile before CoreCompile (live at the Csc task, unlike resources).
       The stubs pass writes none of these outputs. -->
  <Target Name="_HeddleCompile"
          Inputs="@(HeddleTemplate);@(_HeddleImplementationImage);$(MSBuildAllProjects)"
          Outputs="$(_HeddleArtifactPath);$(_HeddleSourcePath);$(_HeddleStampPath)"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_HeddlePaths;_HeddleCollectImages;_HeddleEngineReference;_HeddleProbe;_HeddleIntermediateCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '@(HeddleTemplate)' != ''">
    <ItemGroup>
      <_HeddleCompileItem Include="@(HeddleTemplate)" Condition="'%(HeddleTemplate.Precompile)' != 'false'" />
      <_HeddleImportItem Include="@(HeddleTemplate)" Condition="'%(HeddleTemplate.Precompile)' == 'false'" />
      <_HeddleImplementationImage Include="@(_HeddleIntermediateModel)" />
    </ItemGroup>
    <HeddleCompile
        Templates="@(_HeddleCompileItem)"
        ImportOnly="@(_HeddleImportItem)"
        ProjectPath="$(MSBuildProjectFullPath)"
        TemplateRoot="$(HeddleTemplateRoot)"
        OutputProfile="$(HeddleOutputProfile)"
        ExpressionMode="$(HeddleExpressionMode)"
        TrimDirectiveLines="$(HeddleTrimDirectiveLines)"
        MaxRecursionCount="$(HeddleMaxRecursionCount)"
        GeneratedNamespace="$(HeddleGeneratedNamespace)"
        ImplementationImages="@(_HeddleImplementationImage)"
        EngineReference="@(_HeddleEngineReference->'%(FullPath)')"
        ToolPath="$(HeddleToolPath)"
        ResponseFilePath="$(_HeddleResponsePath)"
        ArtifactPath="$(_HeddleArtifactPath)"
        SourcePath="$(_HeddleSourcePath)"
        StampPath="$(_HeddleStampPath)" />
    <ItemGroup>
      <FileWrites Include="$(_HeddleArtifactPath);$(_HeddleSourcePath);$(_HeddleStampPath)" />
      <Compile Include="$(_HeddleSourcePath)" />
    </ItemGroup>
  </Target>

</Project>
