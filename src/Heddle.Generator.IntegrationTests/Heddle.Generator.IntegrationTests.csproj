<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\heddle.snk</AssemblyOriginatorKeyFile>
    <!-- B2-R7: the marker TextEncoder in EncoderDifferentialTests overrides the unsafe char* members. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The generator under test, driven as an analyzer through CSharpGeneratorDriver (D19), and the runtime so
         the differential harness can compile+load generated code and render on both backends (WI9). -->
    <!-- Aliased: phase 5 links the runtime's OutputProfile/ExpressionMode/fingerprint/capabilities sources into
         the generator (D7), so those type names now exist in both assemblies. The alias keeps every unqualified
         use in this suite bound to the runtime copy; DifferentialHarness reaches the generator through it. -->
    <ProjectReference Include="..\Heddle.Generator\Heddle.Generator.csproj" Aliases="generator" />
    <ProjectReference Include="..\Heddle\Heddle.csproj" />
    <!-- Q8.20 — build ORDER only, deliberately not a compile-time reference. `CorpusResolverSweepTests` reaches into
         Heddle.Tests' own build output (it substitutes this assembly's path to find Heddle.Tests.dll, loads it as a
         MetadataReference, and reads the corpus from src/Heddle.Tests/TestTemplate), and nothing ordered this project
         after that one — so under `dotnet test Heddle.sln` its VSTest run could start before or during that build.
         Reproduced, not theorised: 1 of 30 solution runs failed three sweep cases on the "corpus was not found for
         this TFM" hard failure.
         `ReferenceOutputAssembly="false"` is the point of the shape, not a detail: this suite hands hand-filtered
         reference sets to the compilations it creates (it already strips Heddle.Generator to avoid CS0433 on the
         phase-5 linked types), and pulling Heddle.Tests and its transitive graph into its own compile would put a
         second set of names in scope for no benefit — the test loads the DLL by path at run time, not by reference.
         A stopgap: phase 7's shared corpus is expected to remove the cross-project read entirely. -->
    <ProjectReference Include="..\Heddle.Tests\Heddle.Tests.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
