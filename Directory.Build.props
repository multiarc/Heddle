<Project>

  <!--
    Shared metadata for all projects in the repository. Per-project values
    (PackageId, Product, Description) live in the individual .csproj files.
    Packaging-only properties are harmless on non-packable projects.
  -->
  <PropertyGroup>
    <!-- The release line, stated once. The statements that cannot live here — npm manifests, the VS Code
         extension's NuGet tool pin, the LSP workflow's explicit version argument, the prose release-line sentences —
         are held in step by VersionConsistencyTests.
         VersionPrefix, not Version, so a `dotnet pack` version-suffix argument of `beta.N` composes 2.1.0-beta.N and
         CI's release job can still override the whole thing from the tag. A suffix must NOT carry its own leading
         dash: the SDK joins prefix and suffix with one. -->
    <VersionPrefix>2.1.0</VersionPrefix>
    <Authors>Aliaksandr Kukrash</Authors>
    <Company />
    <Copyright>Copyright 2026 Aliaksandr Kukrash</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/multiarc/Heddle</PackageProjectUrl>
    <RepositoryUrl>https://github.com/multiarc/Heddle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>template;template-engine;text;codegen;razor-alternative</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Symbol package format for the library packages that opt in with IncludeSymbols (below).
         Kept out of the CI `dotnet pack` command line: a global -p:IncludeSymbols=true also forces
         a symbol package for the RID-specific-tool wrapper packages, which have no assembly, so NuGet
         fails with NU5017. Setting IncludeSymbols per-project lets the tools/generator opt out. -->
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- No target is out of support today: net6.0 is retired, and netstandard2.0 and net48 never raise
         NETSDK1138. Kept because net8.0's LTS window closes 2026-11-10, after which every net8.0 build
         would warn; this acknowledges that in advance rather than reddening the build on a date. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Every test project runs under tests.runsettings, which fails a run that executes no tests.
         Harmless on non-test projects, which never read it. -->
    <RunSettingsFilePath Condition="'$(RunSettingsFilePath)' == ''">$(MSBuildThisFileDirectory)tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
